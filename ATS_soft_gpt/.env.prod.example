# Copy to .env.prod and replace every placeholder with a unique random value.
# Use URL-safe passwords for PostgreSQL and Redis (for example, base64url output) so connection URLs parse correctly.
ATS_DOMAIN=ats.example.com
ATS_SECRET_KEY=replace-with-at-least-32-random-bytes
ATS_OWNER_DB_PASSWORD=replace-owner-password
ATS_APP_DB_PASSWORD=replace-app-password
ATS_REDIS_PASSWORD=replace-redis-password
MINIO_ROOT_USER=atsminio
MINIO_ROOT_PASSWORD=replace-minio-password
ATS_S3_APP_PASSWORD=replace-s3-app-password
ATS_WORKERS=4

# Optional AI settings. CV embedding vectors are generated locally by the configured embedding model.
ATS_OPENAI_API_KEY=
ATS_LLM_MODEL=gpt-4o-mini
ATS_LLM_BASE_URL=
ATS_LLM_API_KEY=
ATS_LLM_JSON_MODE=auto
ATS_LLM_LABEL=
ATS_AI_MONTHLY_CAP=5000
