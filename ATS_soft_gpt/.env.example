# Copy to .env and edit. Every ATS_* variable maps to app/config.py.

# Required in production: a long random string (python -c "import secrets; print(secrets.token_urlsafe(48))").
# If empty, a key is generated into ./ats_secret.key (fine for a single local machine only).
ATS_SECRET_KEY=

# Host names the app answers to (JSON list). Add your public domain; keep localhost for the health check.
ATS_ALLOWED_HOSTS=["localhost","127.0.0.1"]

# platform = no sign-up; the creator (made with `python -m app.cli create-creator`) and Rise admins create every company
# open = anyone may create a company (self-service SaaS)
# closed = only the first-run setup creates the single company; everyone else is invited (self-hosted)
ATS_SIGNUP_MODE=platform

# Set true when served over HTTPS (marks the refresh cookie Secure).
ATS_COOKIE_SECURE=false

# Set true only when running behind your own reverse proxy that sets X-Forwarded-For.
ATS_TRUST_PROXY=false

# Database. Docker Compose uses PostgreSQL (pgvector) by default; local Python runs use SQLite.
# Set a password for the local PostgreSQL container. Keep this value private.
POSTGRES_PASSWORD=replace-with-a-long-random-password
# Optional override; the default points to the postgres service in docker-compose.yml.
# PGPASSWORD supplies the password to the PostgreSQL driver, so URL-reserved characters are supported.
# ATS_DATABASE_URL=postgresql+psycopg://ats@postgres:5432/ats

# Development runs: create tables automatically on start. Production uses the migration service in docker-compose.prod.yaml.
# ATS_AUTO_CREATE_TABLES=true

# Host port published by docker compose.
# ATS_PUBLISH_PORT=8000

# --- AI features (CV parsing, job requirement extraction) ---
# Empty = AI off: Upload CV is hidden and jobs take requirements by hand. Keyword search and matching still work.
# When set, CV text and pasted job descriptions are sent to OpenAI, but only for companies that switched AI on
# themselves (Settings, owner only) or had Rise switch it on. New companies start with AI off.
ATS_OPENAI_API_KEY=
# A small, cheap model is enough.
# ATS_LLM_MODEL=gpt-4o-mini

# Or use an open-source model on your own server instead (nothing then leaves your network). Any OpenAI-compatible
# endpoint works. To switch model, change these two lines and restart; `python -m app.cli test-llm` checks it.
# Ollama:     ATS_LLM_BASE_URL=http://localhost:11434/v1       ATS_LLM_MODEL=gpt-oss:20b  (or qwen3:14b, qwen2.5:14b ...)
# VLLM:       ATS_LLM_BASE_URL=http://gpu-box:8000/v1          ATS_LLM_MODEL=openai/gpt-oss-20b
# LM Studio:  ATS_LLM_BASE_URL=http://localhost:1234/v1
# ATS_LLM_BASE_URL=
# ATS_LLM_API_KEY=
# ATS_LLM_JSON_MODE=auto      # auto | schema | object (use object if the server mishandles strict JSON schemas)
# ATS_LLM_MAX_TOKENS=4000     # reasoning models think before answering; raise this if replies are cut off
# ATS_LLM_LABEL=              # shown to users as where text is sent, e.g. "our own server in Mumbai"

# Local embedding model (no per-call cost). Docker bakes it into /opt/models.
# ATS_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# ATS_EMBEDDING_CACHE_DIR=./models_cache
# ATS_MAX_CV_BYTES=5242880    # Largest CV accepted, in bytes (default 5 MB).
# ATS_AI_MONTHLY_CAP=5000     # AI calls allowed per company per month (default 5000).

# --- Production / scale (see docker-compose.prod.yml and .env.prod.example for a ready-made stack) ---
# production = refuse to start on unsafe settings (SQLite, no secret key, non-HTTPS cookies, auto-created tables,
#              several workers without Redis, CV files in the database)
# ATS_ENVIRONMENT=development

# App processes started by `python -m app`.
# ATS_WORKERS=1

# Shared rate-limit store; required with more than one worker. Empty = per-process memory.
# ATS_REDIS_URL=redis://redis:6379/0

# Where CV files live: db (inside the database, small installs), disk, or s3 (AWS S3, MinIO, any S3-compatible store).
# ATS_STORAGE_BACKEND=db
# ATS_STORAGE_DIR=./cv_files
# ATS_S3_BUCKET=
# ATS_S3_ENDPOINT_URL=
# ATS_S3_REGION=
# ATS_S3_ACCESS_KEY=
# ATS_S3_SECRET_KEY=

# Seconds between passes of `python -m app.worker`.
# ATS_INDEX_INTERVAL_SECONDS=30
